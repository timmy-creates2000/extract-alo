modules = ["nodejs-18"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
SUPABASE_URL = "https://oninbasktbcdyhunlikt.supabase.co"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run extraction"

[[workflows.workflow]]
name = "Run extraction"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run extract"

[workflows.workflow.metadata]
outputType = "console"
